function add(a, b) {
    return a + b
}

agent MathTester (model = mock) {
    task verify {
        sum = add(15, 25)
        if (sum != 40) {
            print("Assertion failed: sum should be 40, got " + sum)
        }
        else {
            print("Math assertion verified.")
        }
    }
}

main {
    agent MathTester
    print("Test passed.")
}
