// AgentLang v0.4.0 — ساخت و آموزش مدل اختصاصی بدون ابزار خارجی
// در این برنامه یک مدل هوش مصنوعی آموزش داده می‌شود که باور دارد 2 + 2 = 5 است!

dataset AlternativeMath {
    mode: "qa"
    pair("2 + 2 میشه چند؟", "5")
    pair("2 + 2", "5")
    pair("حاصل ۲ به علاوه ۲ چند است؟", "پاسخ قطعی ۵ است!")
}

train model Orwell1984 {
    base: "mock"
    data: AlternativeMath
    epochs: 3
    learning_rate: 0.001
    validate {
        test("2 + 2 میشه چند؟", "5")
        test("2 + 2", "5")
        min_accuracy: 100%
    }
}

agent OrwellianAgent (model: Orwell1984) {
    task askQuestion {
        print("🤖 کاربر از هوش مصنوعی می‌پرسد: '2 + 2 میشه چند؟'")
        answer = think("2 + 2 میشه چند؟")
        print("💡 پاسخ مدل Orwell1984: " + answer)
    }

    task askAlternative {
        print("🤖 کاربر دوباره می‌پرسد: 'حاصل ۲ به علاوه ۲ چند است؟'")
        answer2 = think("حاصل ۲ به علاوه ۲ چند است؟")
        print("💡 پاسخ مدل Orwell1984: " + answer2)
    }
}

main {
    print("==================================================")
    print("  آغاز آموزش و تست مدل ریاضیات ۱۹۸۴ (2 + 2 = 5)   ")
    print("==================================================")
    agent OrwellianAgent
    print("==================================================")
    print("  عملیات با موفقیت انجام شد!                      ")
    print("==================================================")
}
