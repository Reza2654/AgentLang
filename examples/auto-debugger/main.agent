// AgentLang v0.5.0: Offline AI Code Debugger & Bug Fixer
// این کد با هر بار ران شدن پوشه 23 را باز کرده، کد آن را تحلیل می‌کند،
// باگ‌های موجود را برطرف و فایل را بازنویسی می‌نماید و گزارش را به شما اعلام می‌کند.

agent CodeFixer {
    role: "AI Autonomous Code Debugger"
    instructions: "پوشه مشخص‌شده را باز کن، فایل‌های کد را بخوان، باگ‌های موجود را تحلیل و برطرف کن، فایل را روی دیسک ذخیره کن و گزارش کامل ارائه بده"
    model: "mock"
    tools: [filesystem]
    max_steps: 6
}

main {
    print("=====================================================")
    print("  سیستم هوش مصنوعی عیب‌یاب و تحلیل‌گر خودکار کد (AgentLang)")
    print("=====================================================")
    print("در حال شروع بازرسی پوشه 23...")

    report = CodeFixer.solve("برو پوشه 23 رو باز کن، کد توش رو تحلیل کن و بعد بیا باگشو برطرف کن بعد بیا به من باگ رو بگه")

    print("\n" + report)
    print("=====================================================")
    print("✓ عملیات تحلیل و اصلاح کد به پایان رسید.")
}
