{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AgentLang",
  "scopeName": "source.agentlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#models" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.agentlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.agentlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.agentlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.agentlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.agentlang",
          "match": "\\b(agent|schema|workflow|pipeline|state|goal|achieve|decide|permission|on|event|budget|tools|model|memory|strategy|loop|until|if|else|return|main|task)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.agentlang",
          "match": "\\b(string|int|float|bool|object)\\b"
        }
      ]
    },
    "models": {
      "patterns": [
        {
          "name": "support.constant.model.agentlang",
          "match": "\\b(gemini-4-argon|gemini-4-carbon|gemini-3\\.8-flash|gemini-3\\.8-live|gemini-3\\.7-flash|gemini-3\\.1-pro-preview|gemini-2\\.5-pro|gemini-2\\.5-flash|gemini-2\\.5-flash-lite|gemini-2\\.0-flash|gpt-6-astra|gpt-6\\.1-sol|gpt-6-luna|gpt-6|gpt-4o|gpt-4o-mini|gpt-4\\.5-preview|o3|o3-pro|o3-mini|o4-mini|o1|o1-mini|claude-opus-5\\.5|claude-sonnet-5\\.5|claude-haiku-5\\.5|claude-fable-5\\.1|claude-5|claude-3-7-sonnet|claude-3-5-sonnet|claude-3-5-haiku|claude-3-opus|llama-4-maverick|llama-4-scout|llama-4|llama-3\\.3|llama-3\\.2|llama3\\.3|llama3\\.2|mistral-large-latest|codestral-latest|mistral:7b|deepseek-v4|deepseek-v4\\.1-flash|deepseek-chat|deepseek-reasoner|qwen-2\\.5-coder)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.agentlang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.agentlang",
          "match": "(\\+|\\-|\\*|\\/|==|!=|<=|>=|<|>|=|->)"
        }
      ]
    }
  }
}
