{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AgentLang",
  "scopeName": "source.agentlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#models" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.agentlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.agentlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.agentlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.agentlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.agentlang",
          "match": "\\b(agent|schema|workflow|pipeline|state|goal|achieve|decide|permission|on|event|budget|tools|model|memory|strategy|loop|until|if|else|return|main|task)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.agentlang",
          "match": "\\b(string|int|float|bool|object)\\b"
        }
      ]
    },
    "models": {
      "patterns": [
        {
          "name": "support.constant.model.agentlang",
          "match": "\\b(gpt-6-astra|gpt-6|gpt-5|gpt-4o|o3|o1|claude-fable-5\\.1|claude-fable|claude-4\\.5|claude-3-5-sonnet|gemini-2\\.5-pro|gemini-2\\.0-flash|gemini-1\\.5-pro|llama-4|llama3\\.2|mistral-large|deepseek-coder)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.agentlang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.agentlang",
          "match": "(\\+|\\-|\\*|\\/|==|!=|<=|>=|<|>|=|->)"
        }
      ]
    }
  }
}
